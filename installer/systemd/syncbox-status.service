[Unit]
Description=DIY Sync Box front-panel status LED (GPIO17)
After=hyperhdr@__USER__.service

[Service]
Type=simple
User=__USER__
Environment=HYPERHDR_URL=http://127.0.0.1:8090
ExecStart=/usr/bin/python3 /opt/syncbox/syncbox-status.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
