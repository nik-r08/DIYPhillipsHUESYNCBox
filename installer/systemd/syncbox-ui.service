[Unit]
Description=DIY Sync Box control page (port 80)
After=network.target hyperhdr@__USER__.service
Wants=hyperhdr@__USER__.service

[Service]
Type=simple
User=__USER__
Environment=SYNCBOX_CONFIG=/etc/syncbox/syncbox.json
Environment=HYPERHDR_URL=http://127.0.0.1:8090
ExecStart=/usr/bin/python3 /opt/syncbox/ui/app.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
WatchdogSec=60

[Install]
WantedBy=multi-user.target
